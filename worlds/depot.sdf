<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="depot">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- World Plugins -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- GUI Setup -->
    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5984631152222222 0.5984631152222222 0.5984631152222222</ambient_light>
        <background_color>0.8984631152222222 0.8984631152222222 0.8984631152222222</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>

    <!-- Environmental Parameters -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Base Model -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Depot</uri>
      <experimental:params xmlns:experimental="http://sdformat.org/schemas/experimental">
        <visual element_id="Fan1::visual" action="remove"/>
        <visual element_id="Fan2::visual" action="remove"/>
        <visual element_id="main::ROOF_visual" action="remove"/>
        <visual element_id="main::FANS_visual" action="remove"/>
        <visual element_id="main::PILLERS_visual" action="remove"/>
        <visual element_id="main::crates" action="remove"/>
        <visual element_id="main::BOXSET_visual" action="remove"/>
      </experimental:params>
    </include>

    <!-- Representative wind from the two real K-Tool 42" belt-drive drum fans (14,800 CFM @
         537 RPM) at world (x,y) = (-2, +2) and (-2, -2), ASSUMED blowing in +X (toward the
         flight envelope centered on the origin -- traj1 spans x in [-1.5,1.5], y in [-3,3],
         z(ENU) in [0.5,1.0], per conf/config.yaml). Flip FX sign/rework center/force below if
         that blow-direction assumption is wrong.

         Exit velocity: Q=14800 CFM=6.985 m^3/s, A=pi*(1.0668/2)^2=0.893 m^2 (42" face) ->
         v_exit = Q/A ~= 7.8 m/s. Drum fans of this size are rated for long, coherent throw
         (~60-100 ft usable), so velocity at the ~2-4m fan-to-drone range is assumed to retain
         roughly half that (~4 m/s), NOT a naive spherical 1/r^2 falloff -- this is an estimate,
         not a measurement; treat FORCE below the same way AIR_DENSITY_KG_M3 was treated
         (retune by feel against real data, not first-principles-exact).

         Two zones per fan needed (base_link + slung_load_link) since LocalizedWindPlugin binds
         to exactly one model+link per instance -- both instances target the SAME geometry so
         the drone body and the hanging payload see the same wind column, just scaled by each
         body's own frontal area (drone ~0.09 m^2 assumed vs payload's actual 0.014 m^2
         crossflow area from generate-slung-load-model.py, both at Cd~1, rho=1.225,
         v=4m/s: F=0.5*rho*Cd*A*v^2). NOTE the plugin's internal RNG is seeded identically
         (1337, hardcoded) in every instance, so the two links' turbulence draws are perfectly
         correlated, not independent -- fine for a first pass, but not physically distinct gusts. -->
    <plugin filename="LocalizedWindPlugin" name="aviary::LocalizedWindPlugin">
      <target_model>px4_1</target_model>
      <target_link>base_link</target_link>
      <wind_zone>
        <name>fan_left_base</name>
        <center>-2 2 0.75</center>
        <core_size>4.0 1.2 1.2</core_size>
        <buffer>1.0</buffer>
        <force>0.88 0 0</force>
        <noise_std_dev>0.3</noise_std_dev>
      </wind_zone>
      <wind_zone>
        <name>fan_right_base</name>
        <center>-2 -2 0.75</center>
        <core_size>4.0 1.2 1.2</core_size>
        <buffer>1.0</buffer>
        <force>0.88 0 0</force>
        <noise_std_dev>0.3</noise_std_dev>
      </wind_zone>
    </plugin>
    <plugin filename="LocalizedWindPlugin" name="aviary::LocalizedWindPlugin">
      <target_model>px4_1</target_model>
      <target_link>slung_load_link</target_link>
      <wind_zone>
        <name>fan_left_payload</name>
        <center>-2 2 0.75</center>
        <core_size>4.0 1.2 1.2</core_size>
        <buffer>1.0</buffer>
        <force>0.15 0 0</force>
        <noise_std_dev>0.05</noise_std_dev>
      </wind_zone>
      <wind_zone>
        <name>fan_right_payload</name>
        <center>-2 -2 0.75</center>
        <core_size>4.0 1.2 1.2</core_size>
        <buffer>1.0</buffer>
        <force>0.15 0 0</force>
        <noise_std_dev>0.05</noise_std_dev>
      </wind_zone>
    </plugin>
  </world>
</sdf>
