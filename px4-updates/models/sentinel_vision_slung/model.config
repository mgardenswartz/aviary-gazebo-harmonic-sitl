<?xml version="1.0"?>
<model>
  <name>sentinel_vision_slung</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    sentinel_vision plus a rigid-rod slung payload (two free-pivoting ball joints, upright
    cylindrical mass) for slung-load trajectory-tracking tests. model.sdf in this directory is
    generated by generate-slung-load-model.py from the SLUNG_MASS_KG env var -- see
    model.sdf.template and do not hand-edit model.sdf, it will be overwritten on the next
    generation run.
  </description>
</model>
