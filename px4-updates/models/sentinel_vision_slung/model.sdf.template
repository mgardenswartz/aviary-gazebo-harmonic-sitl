<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='sentinel_vision_slung'>
    <include merge='true'>
      <uri>sentinel</uri>
    </include>

    <!-- Slung load: a rigid rod connects base_link to an upright cylindrical payload via two
         ball joints (free rotation at both ends — pivot-pivot, no torque transfer through the
         rod), not a single-pivot pendulum straight off base_link like the earlier reference
         model. Rod length/radius and payload radius/height are fixed constants (see
         generate-slung-load-model.py) so mass sweeps only ever change PAYLOAD_MASS_KG and its
         derived inertia — everything else about the geometry stays identical between runs.
         The rod's mass is a small nonzero stand-in for "massless" (most physics engines reject
         exactly zero mass/inertia); if the rod jitters/vibrates in the sweep, that's a known
         risk of this two-very-different-mass-scale joint chain, not necessarily a modeling bug —
         try bumping ROD_MASS_KG up before suspecting the payload dynamics themselves.
         Neither link has a <collision> (visual only), matching the earlier reference model's
         choice to isolate pendulum dynamics from the contact solver — revisit only if we
         actually want to model the load hitting something. Since there's no collision, spawning
         below ground level (e.g. QUAD1_LOCATION z=0) is visually odd but not a physics problem —
         no contact solver reaction, since there's nothing here to generate contact with.

         Attach point (ATTACH_X/Y/Z_M) is the center of one landing gear's horizontal foot pad
         (base_link_collision_3 in sentinel_base/model.sdf, i.e. one arm of the inverted-T leg),
         not base_link's own origin — the legs aren't separate links/joints in this model, just
         collision boxes glued onto base_link, so this is purely a different offset on the same
         rigid body, not a joint to a different body.

         Damping is real aerodynamic quadratic drag via the gz-sim Hydrodynamics system plugin
         (force = -0.5 * air_density * Cd * A * v*|v|, per axis — see the xUabsU-style
         parameters below), NOT SDF's <velocity_decay>, which is confirmed unimplemented/silently
         ignored by gz-physics's DART backend as of Harmonic (gz-physics#635) — setting it had
         zero effect at any magnitude, hence its absence here. Coefficients are derived in
         generate-slung-load-model.py from each link's own radius/length; rotational (roll/pitch/
         yaw) damping is a rough strip-theory estimate, not rigorously derived like the
         translational terms — retune if payload spin specifically looks wrong. Added-mass terms
         (xDotU etc.) are left at 0: negligible for a small solid body in air (they matter for
         displacement-scale bodies in water, which is what this plugin was built for).

         GENERATED FILE — edit generate-slung-load-model.py and re-run it, don't hand-edit
         this output (model.sdf) directly, your changes will be overwritten. -->

    <link name="rod_link">
      <pose relative_to="base_link">{ATTACH_X_M} {ATTACH_Y_M} {ROD_MIDPOINT_Z} 0 0 0</pose>
      <inertial>
        <mass>{ROD_MASS_KG}</mass>
        <inertia>
          <ixx>{ROD_IXX}</ixx><iyy>{ROD_IXX}</iyy><izz>{ROD_IZZ}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod_visual">
        <geometry>
          <cylinder>
            <radius>{ROD_RADIUS_M}</radius>
            <length>{ROD_LENGTH_M}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rod_top_pivot" type="ball">
      <pose relative_to="base_link">{ATTACH_X_M} {ATTACH_Y_M} {ATTACH_Z_M} 0 0 0</pose>
      <parent>base_link</parent>
      <child>rod_link</child>
    </joint>

    <link name="slung_load_link">
      <pose relative_to="base_link">{ATTACH_X_M} {ATTACH_Y_M} {PAYLOAD_CENTER_Z} 0 0 0</pose>
      <inertial>
        <mass>{PAYLOAD_MASS_KG}</mass>
        <inertia>
          <ixx>{PAYLOAD_IXX}</ixx><iyy>{PAYLOAD_IXX}</iyy><izz>{PAYLOAD_IZZ}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="slung_load_visual">
        <geometry>
          <cylinder>
            <radius>{PAYLOAD_RADIUS_M}</radius>
            <length>{PAYLOAD_HEIGHT_M}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.3 0.8 1</ambient>
          <diffuse>0.1 0.3 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rod_bottom_pivot" type="ball">
      <pose relative_to="base_link">{ATTACH_X_M} {ATTACH_Y_M} {ROD_BOTTOM_Z} 0 0 0</pose>
      <parent>rod_link</parent>
      <child>slung_load_link</child>
    </joint>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>250</odom_publish_frequency>
      <!-- Left disabled: the vision_odometry_noise ROS 2 node owns all noise/jitter
           injection (per sensor_noise_profile.json), not this plugin. -->
      <!-- <gaussian_noise>0.1</gaussian_noise> -->
    </plugin>

    <!-- Real aerodynamic quadratic drag (Fossen model, force = coeff * v*|v| per axis), derived
         from each link's own crossflow/end-cap area in air — see generate-slung-load-model.py.
         Verified parameter names against /usr/share/gz/gz-sim8/worlds/auv_controls.sdf on this
         host (an installed gz-sim demo world), not guessed from memory. -->
    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>rod_link</link_name>
      <xDotU>0</xDotU><yDotV>0</yDotV><zDotW>0</zDotW>
      <kDotP>0</kDotP><mDotQ>0</mDotQ><nDotR>0</nDotR>
      <xUabsU>{ROD_X_UABSU}</xUabsU><xU>0</xU>
      <yVabsV>{ROD_Y_VABSV}</yVabsV><yV>0</yV>
      <zWabsW>{ROD_Z_WABSW}</zWabsW><zW>0</zW>
      <kPabsP>{ROD_K_PABSP}</kPabsP><kP>0</kP>
      <mQabsQ>{ROD_M_QABSQ}</mQabsQ><mQ>0</mQ>
      <nRabsR>{ROD_N_RABSR}</nRabsR><nR>0</nR>
    </plugin>

    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>slung_load_link</link_name>
      <xDotU>0</xDotU><yDotV>0</yDotV><zDotW>0</zDotW>
      <kDotP>0</kDotP><mDotQ>0</mDotQ><nDotR>0</nDotR>
      <xUabsU>{PAYLOAD_X_UABSU}</xUabsU><xU>0</xU>
      <yVabsV>{PAYLOAD_Y_VABSV}</yVabsV><yV>0</yV>
      <zWabsW>{PAYLOAD_Z_WABSW}</zWabsW><zW>0</zW>
      <kPabsP>{PAYLOAD_K_PABSP}</kPabsP><kP>0</kP>
      <mQabsQ>{PAYLOAD_M_QABSQ}</mQabsQ><mQ>0</mQ>
      <nRabsR>{PAYLOAD_N_RABSR}</nRabsR><nR>0</nR>
    </plugin>
  </model>
</sdf>
