<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='sentinel_vision_slung'>
    <include merge='true'>
      <uri>sentinel</uri>
    </include>

    <!-- Slung load: a rigid rod connects base_link to an upright cylindrical payload via two
         ball joints (free rotation at both ends — pivot-pivot, no torque transfer through the
         rod), not a single-pivot pendulum straight off base_link like the earlier reference
         model. Rod length/radius and payload radius/height are fixed constants (see
         generate-slung-load-model.py) so mass sweeps only ever change PAYLOAD_MASS_KG and its
         derived inertia — everything else about the geometry stays identical between runs.
         The rod's mass is a small nonzero stand-in for "massless" (most physics engines reject
         exactly zero mass/inertia); if the rod jitters/vibrates in the sweep, that's a known
         risk of this two-very-different-mass-scale joint chain, not necessarily a modeling bug —
         try bumping ROD_MASS_KG up before suspecting the payload dynamics themselves.
         Neither link has a <collision> (visual only), matching the earlier reference model's
         choice to isolate pendulum dynamics from the contact solver — revisit only if we
         actually want to model the load hitting something.

         GENERATED FILE — edit generate-slung-load-model.py and re-run it, don't hand-edit
         this output (model.sdf) directly, your changes will be overwritten. -->

    <link name="rod_link">
      <pose relative_to="base_link">0 0 {ROD_MIDPOINT_Z} 0 0 0</pose>
      <inertial>
        <mass>{ROD_MASS_KG}</mass>
        <inertia>
          <ixx>{ROD_IXX}</ixx><iyy>{ROD_IXX}</iyy><izz>{ROD_IZZ}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod_visual">
        <geometry>
          <cylinder>
            <radius>{ROD_RADIUS_M}</radius>
            <length>{ROD_LENGTH_M}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rod_top_pivot" type="ball">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rod_link</child>
    </joint>

    <link name="slung_load_link">
      <pose relative_to="base_link">0 0 {PAYLOAD_CENTER_Z} 0 0 0</pose>
      <inertial>
        <mass>{PAYLOAD_MASS_KG}</mass>
        <inertia>
          <ixx>{PAYLOAD_IXX}</ixx><iyy>{PAYLOAD_IXX}</iyy><izz>{PAYLOAD_IZZ}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="slung_load_visual">
        <geometry>
          <cylinder>
            <radius>{PAYLOAD_RADIUS_M}</radius>
            <length>{PAYLOAD_HEIGHT_M}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.3 0.8 1</ambient>
          <diffuse>0.1 0.3 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rod_bottom_pivot" type="ball">
      <pose relative_to="base_link">0 0 {ROD_BOTTOM_Z} 0 0 0</pose>
      <parent>rod_link</parent>
      <child>slung_load_link</child>
    </joint>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>250</odom_publish_frequency>
      <!-- Left disabled: the vision_odometry_noise ROS 2 node owns all noise/jitter
           injection (per sensor_noise_profile.json), not this plugin. -->
      <!-- <gaussian_noise>0.1</gaussian_noise> -->
    </plugin>
  </model>
</sdf>
