<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_odometry_noise</name>
  <version>0.0.0</version>
  <description>Injects noisy, jittered external-vision odometry (position/orientation/velocity) sourced from Gazebo ground truth, published to PX4 as vehicle_visual_odometry.</description>
  <maintainer email="max.gardenswartz@proton.me">mgardenswartz@ad.ufl.edu</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
