CONTAINER_NAME="px4-sitl-gz"

# Ablation switch for vision_odometry_noise_node only now -- PX4's EKF2_EVV_NOISE/
# EKF2_EVP_NOISE/EKF2_EV_DELAY are all unconditional (see 4100_gz_sentinel), no longer tied to
# this flag. true: the noise node publishes realistic noisy/jittered vehicle_visual_odometry.
# false: it publishes true ground truth synchronously with zero added noise. Forwarded by
# spawn-sim-env.sh to the noise node (and still to px4, harmlessly -- nothing there reads it
# anymore).
NOISE_AND_DELAYS_ON=false

N_TB=0
TB_SPAWN_LOCATIONS=()
N_QUAD=1
QUAD1_LOCATION="0.0,0.0,0.0"
QUAD_SPAWN_LOCATIONS=($QUAD1_LOCATION)
