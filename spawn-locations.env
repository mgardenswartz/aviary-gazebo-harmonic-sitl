CONTAINER_NAME="px4-sitl-gz"

# Ablation switch for vision_odometry_noise_node only now -- PX4's EKF2_EVV_NOISE/
# EKF2_EVP_NOISE/EKF2_EV_DELAY are all unconditional (see 4100_gz_sentinel), no longer tied to
# this flag. true: the noise node publishes realistic noisy/jittered vehicle_visual_odometry on
# a bootstrap-jittered timer. false: it publishes true ground truth with zero added noise on a
# fixed-rate timer (clean_publish_rate_hz, see vision_odometry_noise.yaml). Forwarded by
# spawn-sim-env.sh to the noise node (and still to px4, harmlessly -- nothing there reads it
# anymore).
NOISE_AND_DELAYS_ON=false

# Slung-load ablation. 0 (or unset): spawn the plain sentinel_vision model (no load), unchanged.
# >0: spawn-sim-env.sh spawns sentinel_vision_slung instead -- a rigid rod + upright cylindrical
# payload of this mass (kg), hung via two free-pivoting ball joints (see
# generate-slung-load-model.py). Just edit this value and rerun ./spawn-sim-env.sh -- it
# regenerates model.sdf and redeploys it into the container itself, same as NOISE_AND_DELAYS_ON.
#
# Ground clearance: the rod+payload hang 0.3m + 0.20m = 0.5m below base_link, but base_link
# sits only ~0.02m above the ground at a ground-level spawn -- a slung-load run WILL clip the
# ground at spawn unless QUAD1_LOCATION's z is set to spawn higher (NED, so negative = up; see
# below). spawn-sim-env.sh warns if this looks misconfigured, but doesn't fix it for you.
SLUNG_MASS_KG=0.25

N_TB=0
TB_SPAWN_LOCATIONS=()
N_QUAD=1
QUAD1_LOCATION="0.0,0.0,0.0"
QUAD_SPAWN_LOCATIONS=($QUAD1_LOCATION)
